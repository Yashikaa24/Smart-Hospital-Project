# Backend API URL
VITE_API_URL=http://localhost:8000

# ── Google OAuth Client Configuration ──────────────────────────────────────────
# REQUIRED: Get this from Google Cloud Console → APIs & Services → Credentials
#   1. Go to https://console.cloud.google.com/apis/credentials
#   2. Create or click your OAuth 2.0 Client ID (Type MUST be: Web application)
#   3. Under "Authorized JavaScript Origins" add exact URI without trailing slash:
#        http://localhost:5173
#   4. Under "Authorized redirect URIs" add exact URIs:
#        http://localhost:8000/auth/callback
#        http://localhost:5173/auth/callback
#   5. Copy your Client ID and Client Secret into both frontend and backend .env files
#
# ⚠️ This value MUST exactly match GOOGLE_CLIENT_ID in hospital-backend/.env
# ⚠️ If this value or origin is not configured in Google Cloud Console, you will encounter:
#    "Error 401: invalid_client (The OAuth client was not found)"
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback
